# Development Dockerfile for ESOCS Holy Order Ordination Portal
FROM node:20-alpine AS dev

WORKDIR /app

# Install libc6-compat for Alpine compatibility with Next.js SWC
RUN apk add --no-cache libc6-compat

# Pre-create directories and ensure ownership for node user
RUN mkdir -p /app/.next /app/data /app/node_modules && \
    chown -R node:node /app

# Install dependencies based on package-lock.json
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

# Copy source files with node ownership
COPY --chown=node:node . .

# Ensure .next and data directories are owned by node and fully writable
RUN mkdir -p /app/.next/cache /app/data && chown -R node:node /app && chmod -R 777 /app/.next /app/data

# Environment configuration
ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

USER node

CMD ["npm", "run", "dev"]
