#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit canonical checks..."

# 1. TypeCheck
echo "  ↳ Checking TypeScript types..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript compilation failed. Please fix type errors before committing."
  exit 1
fi

# 2. Lint
echo "  ↳ Linting source files..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Lint errors detected. Please fix linting issues before committing."
  exit 1
fi

echo "✅ Pre-commit verification passed."

